"InstallScript"
{
	"Run Process On Uninstall"
	{
		"Process_name"
		{
			"process 1"		"%INSTALLDIR%\\launcher.exe"
			"command 1"		"-uninstall"
		}
	}
	"Run Process"
	{
		"Fix Windows Network Media Throttle"
		{
			"HasRunKey"		"HKEY_LOCAL_MACHINE\\Software\\Valve\\Steam\\Apps\\431960\\disableNetworkThrottle"
			"process 1"		"%INSTALLDIR%\\launcher.exe"
			"command 1"		"-disablenetworkthrottle"
			"NoCleanUp"		"1"
		}
	}
	"Firewall"
	{
		"Wallpaper Engine UI"		"%INSTALLDIR%\\bin\\wallpaperui.exe"
	}
}
